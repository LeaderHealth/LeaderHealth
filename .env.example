# Server-only GenHealth Client API. Never prefix these with NEXT_PUBLIC_.
# Local checkout reads the Lab Three key from firebase/functions/config.js.
# GEN_HEALTH_API_KEY=
# GEN_HEALTH_PUBLIC_API_BASE_URL=https://api.gen-health.app
# Signing secret from the Gen Health webhook endpoint. The live URL is
# https://leaderhealth.clinic/api/genhealth/webhook
# GEN_HEALTH_WEBHOOK_SECRET=

# Public Collect.js tokenization key is read from storefront/.env.local
# (VITE_NMI_TOKENIZATION_KEY). Do not put NMI_SECURITY_KEY in this file or Vercel.

# Internal checkout app (LeaderHealth-internal---Checkout-Page).
# Shoppers stay on this site's /checkout. The form is embedded from this origin.
# Development defaults to http://localhost:8888.
# A localhost value is ignored on Vercel. Production uses the internal checkout deploy.
# STOREFRONT_APP_ORIGIN=https://leader-health-internal-checkout-page-git-main-leader-health.vercel.app

# Optional origin for JSON-LD URLs. Production defaults to https://leaderhealth.clinic.
# NEXT_PUBLIC_SITE_URL=https://leaderhealth.clinic

# Affiliate tracking. Firestore is server-only. Leave these unset to skip logging.
# The affiliate Firebase project already exists. Paste its service account key.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
# AFFILIATE_ADMIN_EMAIL=
# AFFILIATE_ADMIN_PASSWORD=
# Shared with the internal checkout. It sends this in the x-affiliate-secret header when it records an order.
# AFFILIATE_ORDER_SECRET=
# Optional email sign-in links for /affiliates. Both are required before that form appears.
# AFFILIATE_FROM_EMAIL must be a verified Resend sender, for example Leader Health <affiliates@leaderhealth.clinic>.
# RESEND_API_KEY=
# AFFILIATE_FROM_EMAIL=
# Contact form. Uses the same RESEND_API_KEY. CONTACT_FROM_EMAIL must be on a verified Resend domain.
# Leave CONTACT_TO_EMAIL unset to deliver submissions to support@myleaderhealth.com.
# CONTACT_FROM_EMAIL=noreply@leaderhealth.clinic
# CONTACT_TO_EMAIL=
# Footer newsletter. Private integration from the Leader Health sub-account, scope contacts.write.
# Never prefix these with NEXT_PUBLIC_. Add the same values in Vercel for production.
# GHL_PRIVATE_TOKEN=
# GHL_LOCATION_ID=
# Optional local Firestore emulator. With only FIREBASE_PROJECT_ID set, the Admin SDK uses this host.
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
